# =============================================================================
# CPI API — environnement Docker (docker compose)
#
#   cp docker.env.example .env
#   php artisan key:generate --show   # → APP_KEY
#
# Les hôtes pointent vers les NOMS DE SERVICES compose (postgres, redis) —
# pas 127.0.0.1, qui désignerait le conteneur app lui-même.
# =============================================================================

APP_NAME="CPI Immobilier"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.cpi.sn

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# Port hôte (loopback) sur lequel le proxy TLS forward — voir docker-compose.yml
APP_PORT=8080

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- Base de données (service compose `postgres`) ----------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=cpi
DB_USERNAME=cpi
DB_PASSWORD=

# --- Redis (service compose `redis`, extension phpredis compilée) ------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Cache + sessions sur Redis (les permissions Spatie en profitent directement).
# Les queues restent `sync` tant qu'aucun job n'existe — passer à `redis` avec
# RUN_QUEUE_WORKER=true le jour venu.
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync

# --- Frontend / CORS / proxy -------------------------------------------------
# Doit correspondre EXACTEMENT au domaine servi par le dépôt frontend
# (VITE_SITE_URL = https://monespace.cpi.sn dans son Dockerfile et ses .env).
# `config/cors.php` ne lit que cette variable comme origine autorisée : une
# valeur erronée fait rejeter toutes les requêtes du vrai frontend, et le retour
# OAuth Google pointe vers un domaine où rien n'écoute.
FRONTEND_URL=https://monespace.cpi.sn
SANCTUM_STATEFUL_DOMAINS=monespace.cpi.sn
# Le conteneur est derrière le proxy TLS de l'hôte (port loopback uniquement).
TRUSTED_PROXIES=*

# --- Cloudflare R2 (bucket PRIVÉ — liens signés uniquement) ------------------
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=cpi-documents
R2_URL=
R2_ENDPOINT=

# --- Google OAuth (Socialite) ------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://monespace.cpi.sn/auth/google/callback

# --- Mail (identifiants temporaires du personnel, à brancher) ----------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="contact@cpi.sn"
MAIL_FROM_NAME="${APP_NAME}"
